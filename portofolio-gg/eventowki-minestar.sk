        set item cooldown of player's tool for player to {@cooldown} seconds
        send title "&aPrzedmiot uzyty!" with subtitle "&aUżyles &c&lᴘᴏᴋᴇ&f&lʙᴀʟʟ"
        play sound "minecraft:entity.arrow.shoot" to player
        shoot an arrow at speed 3
        set {_arrow} to last shot projectile
        set name of {_arrow} to "pokeball"
        set {cd.%uuid of player%.pokeball} to now + {@cooldown} seconds
        




on projectile collide:
    name of projectile is "pokeball":
        if chance of {@pokeball-szansa}%:
            play sound "minecraft:entity.experience_orb.pickup" to shooter
            teleport event-entity to shooter
            send "&2✔ &aUdalo ci sie przyciagnac &2%event-entity% &ado siebie!" to shooter
        else:
            send "&4x &cNie udalo sie!"
        
        
    


            






on death:
    victim is a player:
        if victim has {czaszka}:
            keep the inventory and experiences
            remove {czaszka} from victim's inventory
            clear drops
            send title "&aPrzedmiot uzyty!" with subtitle "&aUżyles %name of {czaszka}%" to victim
on damage:
    attacker is player
    victim is player
    if name of attacker's tool is "&x&2&9&b&1&1&c&lᴍ&x&3&c&b&8&1&9&lɪ&x&5&0&b&f&1&7&lᴇ&x&6&3&c&6&1&4&lᴄ&x&7&6&c&d&1&2&lᴢ&x&8&a&d&4&0&f&l &x&9&d&d&c&0&d&lᴄ&x&b&1&e&3&0&a&lʜ&x&c&4&e&a&0&8&lᴡ&x&d&7&f&1&0&5&lᴀ&x&e&b&f&8&0&3&lʟ&x&f&e&f&f&0&0&lʏ":
        chance of {@mieczchwaly-szansa}%:
            
            set block at location of victim to cobweb
            
    if name of victim's chestplate contains "&x&f&f&0&0&0&0&lɢ&x&f&f&2&a&0&0&lᴡ&x&f&f&5&5&0&0&lɪ&x&f&f&7&f&0&0&lᴇ&x&f&f&a&a&0&0&lᴢ&x&f&f&d&4&0&0&lᴅ&x&f&f&f&f&0&0&lɴ&x&a&a&f&f&0&0&lʏ&x&5&5&f&f&0&0&l &x&0&0&f&f&0&0&lɴ&x&0&0&a&a&5&5&lᴀ&x&0&0&5&5&a&a&lᴘ&x&0&0&0&0&f&f&lɪ&x&1&9&0&0&d&5&lᴇ&x&3&2&0&0&a&c&lʀ&x&4&b&0&0&8&2&lꜱ&x&6&3&0&0&9&d&lɴ&x&7&c&0&0&b&8&lɪ&x&9&4&0&0&d&3&lᴋ":
        chance of 5%:
            cancel event
            send title "&6★" with subtitle "&fWykonales unik!" to victim
            send title "&6★" with subtitle "&fPrzeciwnik wykonal unik!" to attacker
    
    if {futro.%uuid of victim%} is set:
        set damage to damage * 0.5
on damage:
    attacker is a player
    victim is a player
    if {kolce.%uuid of victim%} is true:
        
        if chance of {@kolce-szansa}%:
            damage attacker by damage
            send "&cOtrzymałeś obrażenia od kolców przeciwnika!" to attacker
            



 
    

on damage:
    if name of attacker's tool is "&x&9&4&4&c&0&a&lʀ&x&a&3&6&2&1&6&lᴏ&x&b&1&7&8&2&2&l&x&c&0&8&d&2&d&lᴢ&x&c&e&a&3&3&9&lɢ&x&d&d&b&9&4&5&lᴀ":

        if {cd.%uuid of attacker%.rozga} > now:
            send "&cPoczekaj!" to attacker
            cancel event
            stop
        
        set {cd.%uuid of attacker%.rozga} to now + {@cooldown} seconds
        set {elytra-blok.%uuid of victim%} to true
        
        set {_v} to victim
        wait {@rozga-blok} seconds
        delete {elytra-blok.%uuid of {_v}%}

    
    





on elytra boost:
    if the used firework will be consumed:
        if name of event-item is "&x&5&9&0&a&9&4&lꜱ&x&6&0&0&e&9&9&lᴍ&x&6&6&1&1&9&d&lᴏ&x&6&d&1&5&a&2&lᴄ&x&7&4&1&9&a&6&lᴢ&x&7&a&1&c&a&b&lᴀ&x&8&1&2&0&a&f&l &x&8&8&2&4&b&4&lꜰ&x&8&f&2&8&b&9&lᴀ&x&9&5&2&b&b&d&lᴊ&x&9&c&2&f&c&2&lᴇ&x&a&3&3&3&c&6&lʀ&x&a&9&3&6&c&b&lᴡ&x&b&0&3&a&c&f&lᴇ&x&b&7&3&e&d&4&lʀ&x&b&d&4&1&d&8&lᴋ&x&c&4&4&5&d&d&lᴀ":
            prevent the used firework from being consumed

    if {elytra-blok.%uuid of player%} is set:
        cancel event
        send "&cNie możesz używać elytry! Ktoś użył na ciebie rozgi" to player
on right click:
    if name of event-item is "&x&5&9&0&a&9&4&lꜱ&x&6&0&0&e&9&9&lᴍ&x&6&6&1&1&9&d&lᴏ&x&6&d&1&5&a&2&lᴄ&x&7&4&1&9&a&6&lᴢ&x&7&a&1&c&a&b&lᴀ&x&8&1&2&0&a&f&l &x&8&8&2&4&b&4&lꜰ&x&8&f&2&8&b&9&lᴀ&x&9&5&2&b&b&d&lᴊ&x&9&c&2&f&c&2&lᴇ&x&a&3&3&3&c&6&lʀ&x&a&9&3&6&c&b&lᴡ&x&b&0&3&a&c&f&lᴇ&x&b&7&3&e&d&4&lʀ&x&b&d&4&1&d&8&lᴋ&x&c&4&4&5&d&d&lᴀ":
        if targeted block is set:
            if distance between player and targeted block < 5:
                cancel event


function activate_rozga(p: player):
    set {rozga.%{_p}%} to true
    wait 2 seconds
    deactivate_rozga({_p})

function deactivate_rozga(p: player):
    delete {rozga.%{_p}%}
    send "&4✖ &cRózga wygasla!!" to {_p}


on right click:
    if name of event-item contains "&x&9&4&4&c&0&a&lʀ":
        cancel event
       
        
       
        {cd.%uuid of player%.rozga} > now:
            
            send action bar "&cCzekaj!" to player
            stop
        
       
        if clicked entity is a player:
            set {_victim} to clicked entity
            
            if {_victim} is player:
                send "&cNie możesz użyć różgi na sobie!" to player
                stop
            
            
            set {cd.%uuid of player%.rozga} to now + {@cooldown} seconds
            set item cooldown of player's tool for player to {@cooldown} seconds
            
           
            set {elytra-blok.%uuid of {_victim}%} to true
            
            
            send "&a✓ Zablokowałeś elytrę graczowi &f%{_victim}% &ana &e{@rozga-blok} &asekund!" to player
            send "&4x &cKtoś zablokował ci elytrę na &f{@rozga-blok} &csekund!" to {_victim}
            
            
            wait 5 seconds
            if {elytra-blok.%uuid of {_victim}%} is set:
                delete {elytra-blok.%uuid of {_victim}%}
                send "&a✓ Twoja elytra została odblokowana!" to {_victim}
                if player is online:
                    send "&7Elytra gracza &f%{_victim}% &7została odblokowana." to player
        else:
            send "&eℹ Kliknij na gracza, aby zablokować mu elytrę!" to player


on elytra boost:
    if {elytra-blok.%uuid of player%} is set:
        cancel event
        send action bar "&c✖ Nie możesz używać elytry! Ktoś użył na ciebie różgi" to player
on right click with firework:
    if {elytra-blok.%uuid of player%} is set:
        cancel event
